{
  "name": "bilibili_web_fast",
  "version": "1.0.0",
  "description": "Bilibili web playback optimizer extension",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build:page-world": "node scripts/build-page-world.mjs",
    "build": "npm run build:page-world && vite build && node scripts/postbuild-extension.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:real": "npm run build && playwright test --grep @real",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "overrides": {
    "@crxjs/vite-plugin": {
      "rollup": "2.80.0"
    }
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.4.0",
    "@playwright/test": "^1.60.0",
    "@types/chrome": "^0.1.42",
    "@types/node": "^25.9.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  }
}
